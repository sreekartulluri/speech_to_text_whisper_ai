import sounddevice as sd
import numpy as np
from scipy.io.wavfile import write, read
import noisereduce as nr
import librosa
import soundfile as sf
import whisper

# -----------------------------
# Audio Recording
# -----------------------------
DURATION = 10  # seconds
SAMPLE_RATE = 16000

print("Recording...")
audio = sd.rec(
    int(DURATION * SAMPLE_RATE),
    samplerate=SAMPLE_RATE,
    channels=1,
    dtype='float32'
)
sd.wait()
write("sample.wav", SAMPLE_RATE, audio)
print("Recording saved as sample.wav")

# -----------------------------
# Noise Reduction
# -----------------------------
rate, data = read("sample.wav")

if data.dtype != np.float32:
    data = data.astype(np.float32)
    data /= np.max(np.abs(data))

reduced_noise = nr.reduce_noise(y=data, sr=rate)
scaled = np.int16(reduced_noise / np.max(np.abs(reduced_noise)) * 32767)
write("sample_reduced.wav", rate, scaled)

print("Noise reduction applied.")

# -----------------------------
# Silence Removal
# -----------------------------
y, sr = librosa.load("sample_reduced.wav", sr=None)
intervals = librosa.effects.split(y, top_db=15)

trimmed_audio = np.concatenate([y[start:end] for start, end in intervals])
sf.write("sample_trimmed.wav", trimmed_audio, sr)

print("Silence removed.")

# -----------------------------
# Speech-to-Text (Whisper)
# -----------------------------
model = whisper.load_model("large")
result = model.transcribe("sample_trimmed.wav", language="en")

print("Transcription:")
print(result["text"])
